# ArbitrageX Supreme V3.0 - Environment Configuration Template

#==============================================================================
# BLOCKCHAIN RPC ENDPOINTS
#==============================================================================
# WebSocket URLs preferred for real-time mempool monitoring
# Get your API keys from Infura, Alchemy, or QuickNode

# Ethereum Mainnet
ETHEREUM_RPC_URL=wss://mainnet.infura.io/ws/v3/YOUR_PROJECT_ID
ETHEREUM_HTTP_URL=https://mainnet.infura.io/v3/YOUR_PROJECT_ID
ETHEREUM_CHAIN_ID=1

# Polygon
POLYGON_RPC_URL=wss://polygon-mainnet.infura.io/ws/v3/YOUR_PROJECT_ID
POLYGON_HTTP_URL=https://polygon-mainnet.infura.io/v3/YOUR_PROJECT_ID
POLYGON_CHAIN_ID=137

# Arbitrum
ARBITRUM_RPC_URL=wss://arbitrum-mainnet.infura.io/ws/v3/YOUR_PROJECT_ID
ARBITRUM_HTTP_URL=https://arbitrum-mainnet.infura.io/v3/YOUR_PROJECT_ID
ARBITRUM_CHAIN_ID=42161

# Optimism
OPTIMISM_RPC_URL=wss://optimism-mainnet.infura.io/ws/v3/YOUR_PROJECT_ID
OPTIMISM_HTTP_URL=https://optimism-mainnet.infura.io/v3/YOUR_PROJECT_ID
OPTIMISM_CHAIN_ID=10

# Base
BASE_RPC_URL=wss://base-mainnet.infura.io/ws/v3/YOUR_PROJECT_ID
BASE_HTTP_URL=https://base-mainnet.infura.io/v3/YOUR_PROJECT_ID
BASE_CHAIN_ID=8453

#==============================================================================
# PRIVATE KEYS & WALLETS
#==============================================================================
# CRITICAL: Use hardware wallets or secure key management in production
# These should be loaded from secure environment variables or key vaults

# Main trading wallet private key (without 0x prefix)
PRIVATE_KEY=your_main_wallet_private_key_here

# Flash loan execution wallet (separate for security)
FLASH_LOAN_PRIVATE_KEY=your_flash_loan_wallet_private_key_here

# MEV relay signing key
MEV_SIGNING_KEY=your_mev_relay_signing_key_here

# Wallet addresses (derived from private keys above)
MAIN_WALLET_ADDRESS=0x...
FLASH_LOAN_WALLET_ADDRESS=0x...

#==============================================================================
# EXTERNAL API KEYS
#==============================================================================
# Required for price feeds and market data

# DeFiLlama API (free tier available)
DEFILLAMA_API_KEY=your_defillama_api_key
DEFILLAMA_BASE_URL=https://api.llama.fi

# CoinGecko Pro API (required for real-time data)
COINGECKO_API_KEY=your_coingecko_pro_api_key
COINGECKO_BASE_URL=https://pro-api.coingecko.com/api/v3

# 1inch API (for DEX aggregation)
ONEINCH_API_KEY=your_1inch_api_key
ONEINCH_BASE_URL=https://api.1inch.dev

# Moralis API (for NFT and token data)
MORALIS_API_KEY=your_moralis_api_key
MORALIS_BASE_URL=https://deep-index.moralis.io/api/v2

#==============================================================================
# DATABASE CONFIGURATION
#==============================================================================
# PostgreSQL primary database

POSTGRES_HOST=postgres-db
POSTGRES_PORT=5432
POSTGRES_USER=arbitragex
POSTGRES_PASSWORD=ArbitrageX_Supreme_2024_Secure_Password
POSTGRES_DB=arbitragex_supreme
POSTGRES_MAX_CONNECTIONS=100
POSTGRES_SSL_MODE=prefer

# Full database URL
DATABASE_URL=postgresql://arbitragex:ArbitrageX_Supreme_2024_Secure_Password@postgres-db:5432/arbitragex_supreme

# Database pool configuration
DB_POOL_MIN_SIZE=5
DB_POOL_MAX_SIZE=20
DB_POOL_TIMEOUT_SECONDS=30

#==============================================================================
# REDIS CONFIGURATION
#==============================================================================
# Redis for caching and pub/sub

REDIS_HOST=redis-cache
REDIS_PORT=6379
REDIS_PASSWORD=Redis_ArbitrageX_2024_Secure
REDIS_DB=0
REDIS_MAX_CONNECTIONS=50
REDIS_TIMEOUT_SECONDS=5

# Full Redis URL
REDIS_URL=redis://:Redis_ArbitrageX_2024_Secure@redis-cache:6379/0

# Redis pub/sub channels
REDIS_OPPORTUNITIES_CHANNEL=arbitragex:opportunities
REDIS_EXECUTIONS_CHANNEL=arbitragex:executions
REDIS_METRICS_CHANNEL=arbitragex:metrics

#==============================================================================
# SECURITY & AUTHENTICATION
#==============================================================================
# JWT and API security

# Simulation timeout in milliseconds
SIMULATION_TIMEOUT=5000

# Maximum concurrent simulations
MAX_CONCURRENT_SIMS=10

# ===========================================
# RELAY CONFIGURATION
# ===========================================

# Flashbots relay URL
FLASHBOTS_RELAY_URL=https://relay.flashbots.net

# bloXroute relay URL
BLOXROUTE_RELAY_URL=https://mev.api.blxrbdn.com

# Eden relay URL  
EDEN_RELAY_URL=https://api.edennetwork.io/v1

# Builder API key for relays
BUILDER_API_KEY=your_builder_api_key_here

# ===========================================
# API CONFIGURATION
# ===========================================

# JWT secret for API authentication
JWT_SECRET=your_very_secure_jwt_secret_here

# API rate limit (requests per minute)
API_RATE_LIMIT=1000

# Reconciliation interval in milliseconds
RECONCILIATION_INTERVAL=300000

# ===========================================
# MONITORING & ALERTING
# ===========================================

# Grafana admin password
GRAFANA_PASSWORD=secure_grafana_password_here

# SMTP configuration for alerts
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_email_app_password

# Alert email addresses
ALERT_EMAIL_FROM=alerts@arbitragex.io
DEFAULT_EMAIL_TO=admin@arbitragex.io
CRITICAL_EMAIL_TO=critical@arbitragex.io,ceo@arbitragex.io
MEV_TEAM_EMAIL=mev-team@arbitragex.io
INFRA_TEAM_EMAIL=infra@arbitragex.io
SECURITY_TEAM_EMAIL=security@arbitragex.io
TRADING_TEAM_EMAIL=trading@arbitragex.io

# Slack webhook URL for notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK

# PagerDuty routing key for critical alerts
PAGERDUTY_ROUTING_KEY=your_pagerduty_routing_key

# ===========================================
# SECURITY CONFIGURATION
# ===========================================

# SSL certificate paths (for production)
SSL_CERT_PATH=/etc/ssl/certs/arbitragex.crt
SSL_KEY_PATH=/etc/ssl/private/arbitragex.key

# Backup encryption key
BACKUP_ENCRYPTION_KEY=your_backup_encryption_key_here

# ===========================================
# PERFORMANCE TUNING
# ===========================================

# Memory limits (in MB)
SEARCHER_MEMORY_LIMIT=2048
POSTGRES_MEMORY_LIMIT=1024
REDIS_MEMORY_LIMIT=512

# CPU limits (number of cores)
SEARCHER_CPU_LIMIT=2
POSTGRES_CPU_LIMIT=1

# Network settings
MAX_CONNECTIONS=1000
CONNECTION_TIMEOUT=30

# ===========================================
# DEVELOPMENT/TESTING
# ===========================================

# Environment (development|staging|production)
NODE_ENV=production

# Debug mode (true|false)
DEBUG_MODE=false

# Log level (debug|info|warn|error)
LOG_LEVEL=info

# Test mode configuration
TEST_MODE=false
TEST_WALLET_PRIVATE_KEY=your_test_wallet_key