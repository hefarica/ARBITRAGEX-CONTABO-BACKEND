# ArbitrageX Supreme V3.0 - Recon Service Dockerfile
# Multi-stage build for optimized production image

# Build stage
FROM rust:1.75-slim as builder

# Install system dependencies
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    libpq-dev \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy manifests
COPY Cargo.toml Cargo.lock ./
COPY recon/Cargo.toml ./recon/
COPY lib ./lib

# Copy source code
COPY recon/src ./recon/src

# Build for release
RUN cargo build --release --bin recon

# Runtime stage
FROM debian:bookworm-slim

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    ca-certificates \
    libssl3 \
    libpq5 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create app user
RUN groupadd -r arbitragex && useradd -r -g arbitragex arbitragex

# Set working directory
WORKDIR /app

# Copy binary from builder stage
COPY --from=builder /app/target/release/recon /app/recon

# Copy configuration files
COPY config/app.toml /app/config/app.toml

# Set ownership
RUN chown -R arbitragex:arbitragex /app

# Switch to non-root user
USER arbitragex

# Expose port
EXPOSE 8003

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8003/health || exit 1

# Set environment variables
ENV RUST_LOG=info
ENV RUST_BACKTRACE=1
ENV SERVICE_NAME=recon
ENV SERVICE_PORT=8003

# Run the binary
CMD ["./recon"]
