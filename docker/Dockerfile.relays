# Secure Dockerfile with TLS and rate limiting for relays-client
FROM rust:1.75-slim as builder

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    build-essential \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Copy dependency files
COPY relays-client/Cargo.toml relays-client/Cargo.lock ./

# Create dummy src to cache dependencies
RUN mkdir src && echo "fn main() {}" > src/main.rs
RUN cargo build --release && rm -rf src

# Copy real source code
COPY relays-client/src ./src

# Rebuild with real code
RUN touch src/main.rs && cargo build --release

# Runtime stage
FROM debian:bookworm-slim

WORKDIR /app

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    ca-certificates \
    libssl3 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy compiled binary
COPY --from=builder /app/target/release/relays-client /app/relays-client

# Copy TLS certificates
COPY relays-client/certs/ /app/certs/

# Create non-root user
RUN useradd -m -u 1000 relays && chown -R relays:relays /app
USER relays

# Environment variables
ENV RUST_LOG=relays_client=debug
ENV TLS_CERT_PATH=/app/certs/cert.pem
ENV TLS_KEY_PATH=/app/certs/key.pem
ENV RATE_LIMIT_PER_SECOND=10
ENV TIMEOUT_SECONDS=30

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8081/health || exit 1

EXPOSE 8081

CMD ["./relays-client"]
