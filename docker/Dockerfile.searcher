# Multi-stage build for searcher-rs
FROM rust:1.75-slim as builder

# Install build dependencies
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy Cargo files first for better caching
COPY searcher-rs/Cargo.toml searcher-rs/Cargo.lock ./
RUN mkdir src && echo "fn main() {}" > src/main.rs
RUN cargo build --release && rm -rf src

# Copy real source code
COPY searcher-rs/src ./src

# Rebuild with real code
RUN touch src/main.rs && cargo build --release

# Runtime stage
FROM debian:bookworm-slim

WORKDIR /app

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    ca-certificates \
    libssl3 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy compiled binary
COPY --from=builder /app/target/release/searcher-rs /app/searcher-rs

# Create non-root user
RUN useradd -m -u 1000 searcher && chown -R searcher:searcher /app
USER searcher

# Environment variables
ENV RUST_LOG=searcher_rs=debug,web3=info
ENV RPC_URL=http://geth-node:8545
ENV WS_URL=ws://geth-node:8546

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8079/health || exit 1

EXPOSE 8079

CMD ["./searcher-rs"]
