# Dockerfile with Foundry Anvil preinstalled
FROM rust:1.75-slim as builder

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    build-essential \
    git \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install Foundry
RUN curl -L https://foundry.paradigm.xyz | bash
ENV PATH="/root/.foundry/bin:${PATH}"
RUN foundryup

# Copy dependency files
COPY sim-ctl/Cargo.toml sim-ctl/Cargo.lock ./

# Create dummy src to cache dependencies
RUN mkdir src && echo "fn main() {}" > src/main.rs
RUN cargo build --release && rm -rf src

# Copy real source code
COPY sim-ctl/src ./src

# Rebuild with real code
RUN touch src/main.rs && cargo build --release

# Runtime stage
FROM debian:bookworm-slim

WORKDIR /app

# Install runtime dependencies including Foundry
RUN apt-get update && apt-get install -y \
    ca-certificates \
    libssl3 \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

# Install Foundry in runtime
RUN curl -L https://foundry.paradigm.xyz | bash
ENV PATH="/root/.foundry/bin:${PATH}"
RUN foundryup

# Copy compiled binary
COPY --from=builder /app/target/release/sim-ctl /app/sim-ctl

# Create non-root user
RUN useradd -m -u 1000 simctl && chown -R simctl:simctl /app
USER simctl

# Environment variables
ENV RUST_LOG=sim_ctl=debug
ENV PORT=8545
ENV ANVIL_PATH=/root/.foundry/bin/anvil

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8545/health || exit 1

EXPOSE 8545

CMD ["./sim-ctl"]
