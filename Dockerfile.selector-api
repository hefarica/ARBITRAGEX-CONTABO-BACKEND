# ArbitrageX Supreme V3.0 - Selector API Dockerfile
# Multi-stage build for optimized production image

# Build stage
FROM rust:1.75-slim as builder

# Install system dependencies
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    libpq-dev \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy manifests
COPY Cargo.toml Cargo.lock ./
COPY selector-api/Cargo.toml ./selector-api/
COPY lib ./lib

# Copy source code
COPY selector-api/src ./selector-api/src

# Build for release
RUN cargo build --release --bin selector-api

# Runtime stage
FROM debian:bookworm-slim

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    ca-certificates \
    libssl3 \
    libpq5 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create app user
RUN groupadd -r arbitragex && useradd -r -g arbitragex arbitragex

# Set working directory
WORKDIR /app

# Copy binary from builder stage
COPY --from=builder /app/target/release/selector-api /app/selector-api

# Copy configuration files
COPY config/app.toml /app/config/app.toml

# Set ownership
RUN chown -R arbitragex:arbitragex /app

# Switch to non-root user
USER arbitragex

# Expose port
EXPOSE 8002

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8002/health || exit 1

# Set environment variables
ENV RUST_LOG=info
ENV RUST_BACKTRACE=1
ENV SERVICE_NAME=selector-api
ENV SERVICE_PORT=8002

# Run the binary
CMD ["./selector-api"]
